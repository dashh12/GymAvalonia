<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyAvaloniaApp.Views.MiembrosView"
             Background="#121212">

    <Border Padding="25">

        <StackPanel Spacing="20">

            <TextBlock Text="Gestión de Miembros"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="¡Sesión iniciada con éxito!"
                       Foreground="#e2ede7"
                       FontSize="18"/>

            <Button Content="Volver al Inicio"
                    Command="{Binding VolverInicioCommand}"
                    Width="180"
                    Height="45"/>

        </StackPanel>

    </Border>

</UserControl>