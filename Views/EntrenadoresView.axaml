<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyAvaloniaApp.Views.EntrenadoresView"
             Background="#121212">

    <Grid RowDefinitions="Auto,Auto,*" Margin="25">

        <!-- Título y botón para volver -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Entrenadores" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <Button Grid.Column="1" Content="Volver al Inicio" Command="{Binding VolverInicioCommand}"/>
        </Grid>

        <!-- Mensajes de error o de éxito -->
        <TextBlock Grid.Row="1" Text="{Binding Mensaje}" Foreground="Orange" Margin="0,10"/>

        <Grid Grid.Row="2" ColumnDefinitions="2*,*">

            <!-- Buscador y lista -->
            <DockPanel Margin="0,0,20,0">
                <TextBox DockPanel.Dock="Top" Watermark="Buscar..." Text="{Binding Busqueda}" Margin="0,0,0,10"/>

                <ListBox ItemsSource="{Binding Entrenadores}" SelectedItem="{Binding Seleccionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Apellido}" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Especialidad}" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Formulario -->
            <StackPanel Grid.Column="1" Spacing="10">
                <TextBox Watermark="Nombre" Text="{Binding Nombre}"/>
                <TextBox Watermark="Apellido" Text="{Binding Apellido}"/>
                <TextBox Watermark="Especialidad" Text="{Binding Especialidad}"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Guardar" Command="{Binding GuardarCommand}"/>
                    <Button Content="Nuevo" Command="{Binding NuevoCommand}"/>
                    <Button Content="Eliminar" Command="{Binding EliminarCommand}"/>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
