<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyAvaloniaApp.Views.LoginView"
             Background="#121212">

    <Grid RowDefinitions="*, Auto, *">

        <Border Grid.Row="1"
                Width="350"
                Background="#1E1E1E"
                CornerRadius="12"
                Padding="30"
                HorizontalAlignment="Center">

            <StackPanel Spacing="15">

                <TextBlock Text="FITPULSE GYM"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#adbcb5"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Acceso al Sistema"
                           FontSize="14"
                           Foreground="#888888"
                           HorizontalAlignment="Center"/>

                <TextBox Watermark="Usuario"
                         Margin="0,10,0,0"/>

                <TextBox Watermark="Contraseña"
                         PasswordChar="*"/>

                <Button Content="Iniciar Sesión"
                        Command="{Binding IniciarSesionCommand}"
                        Background="#00E676"
                        Foreground="#121212"
                        FontWeight="Bold"
                        Height="40"
                        CornerRadius="6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>